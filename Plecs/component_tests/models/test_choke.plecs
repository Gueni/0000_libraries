"lib/parameters.py); lib/ctest.py passes the current values as ModelVars.\nBen"
"ch.Ch_V0 = 10.0;\nBench.Ch_Va = 20.0;\nBench.Ch_f = 10000.0;\nBench.Ch_Rs = 1"
".0;\nBench.Ch_Rload = 1.0;\nBench.Ch_i1 = 1.0;\nBench.Ch_i2 = -0.5;\nBench.t_"
"choke = 0.002;\nBench.Ch_maxStep = 2e-07;\nBench.Ch_relTol = 1e-06;\nCH.Confi"
"g = 2.0;\nCH.L1 = 0.00024;\nCH.L2 = 1e-05;\nCH.R1 = 0.01;\nCH.R2 = 0.01;\nCH."
"Lm = 1e-06;\nCH.Rm = 0.001;\nCH.i1 = 1.0;\nCH.i2 = -0.5;\nCHR = CH;\nOut.file"
" = 'test_choke.csv';"
