"Bench.t_on2 = 3e-06;\n"
"Bench.t_tail = 3e-06;\n"
"Bench.Tamb = 25.0;\n"
"Bench.maxStep = 1e-07;\n"
"Bench.relTol = 0.0001;\n"
"BD.Config = 2.0;\n"
"BD.therm_diode = 'file:C3M0021120K_bodydiode';\n"
"BD.vf_diode = 4.5;\n"
"BD.ron_diode = 0.005;\n"
"BD.t_init = 25.0;\n"
"BD.num_par_diode = 1.0;\n"
"BD.Case_Cth = 0.0;\n"
"BD.Case_Tinit = 25.0;\n"
"BD.Case_Amb_rth = 0.1;\n"
"BD.nPara = 1.0;\n"
"BD.VI.T = [-40.0 25.0 175.0];\n"
"BD.VI.I = [0.0 0.5 2.0 5.0 8.0 15.0 20.0 30.0 40.0 60.0 80.0 100.0 120.0 1"
"40.0 160.0 180.0 200.0];\n"
"BD.VI.V = [2.85 3.0 3.5 3.9 4.15 4.6 4.77 5.1 5.42 5.9 6.3 6.59 6.9 7.14 7"
".4 7.6 7.84; 2.75 2.9 3.15 3.5 3.75 4.1 4.3 4.66 4.89 5.37 5.77 6.1 6.4 6."
"65 6.9 7.13 7.35; 2.3 2.45 2.74 3.1 3.3 3.6 3.8 4.12 4.4 4.78 5.16 5.46 5."
"75 6.0 6.25 6.47 6.7];\n"
"BD.Ron = 0.012;\n"
"BD.RR.IF = 50.0;\n"
"BD.RR.didt = 2600000000.0;\n"
"BD.RR.Irrm = 42.0;\n"
"BD.RR.trr = 3.4e-08;\n"
"BD.RR.Qrr = 0.0;\n"
"BD.RR.Tmeas = 175.0;\n"
"BD.RR.ktau = 2.0;\n"
"BD.Cj.V = [0.0 1.0 2.0 5.0 10.0 20.0 30.0 50.0 75.0 100.0 150.0 200.0 300."
"0 400.0 600.0 800.0 1000.0 1200.0];\n"
"BD.Cj.C = [4.3e-09 3.2999999999999998e-09 2.6999999999999998e-09 1.9e-09 1"
".3e-09 9.5e-10 8.2e-10 6.5e-10 5.6e-10 5e-10 4.2e-10 3.6e-10 2.8e-10 2.35e"
"-10 1.95e-10 1.82e-10 1.8e-10 1.8e-10];\n"
