            Parameter {
              Variable      "Declarations"
              Value         "/* SiC/Si power MOSFET die model (channel + nonli"
"near capacitances).\n"
" * Inputs : 1 gate command, 2 Vgs(die), 3 Vds(die), 4 Tj [degC]\n"
" * Outputs: 1 channel current D->S [A], 2 [Cgs 0], 3 [Cgd 0], 4 [Cds 0] [F],"
"\n"
" *          5 channel power [W], 6 turn-on switch cmd, 7 turn-off switch cmd"
"\n"
" * Parameters:\n"
" *   0 channel [Vt0 aVt nphi0 K0 bK Rd0 bRd Iq0 bIq theta lambda m]\n"
" *   1 capacitance voltage axis [V]   2 Coss(V) [F]   3 Crss(V) [F]\n"
" *   4 [Ciss Vciss Cgd_ox kdyn Vacc]  5 [Vav Rav]     6 nPara\n"
" * The parameters are copied to the static data below in the start function: "
"the\n"
" * parameter access macros are only available inside the function sections. *"
"/\n"
"#include <math.h>\n"
"\n"
"#define MAX_CAP   64\n"
"\n"
"static double f_ch[12];\n"
"static int    f_nCap;\n"
"static double f_V[MAX_CAP], f_Coss[MAX_CAP], f_Crss[MAX_CAP];\n"
"static double f_Ciss, f_Vciss, f_Cgd_ox, f_kdyn, f_Vacc, f_Vav, f_Rav, f_nPar"
";\n"
"static double ch_Vt, ch_nphi, ch_K, ch_Rd, ch_Iq, ch_theta, ch_lambda, ch_m;"
"\n"
"\n"
"static double softplus(double x)\n"
"{\n"
"   if (x > 30.0) return x;\n"
"   return log1p(exp(x));\n"
"}\n"
"\n"
"/* temperature dependent channel parameters */\n"
"static void chan_update(double Tj)\n"
"{\n"
"   double tn = (Tj + 273.15) / 298.15;\n"
"   if (tn < 0.1) tn = 0.1;\n"
"   ch_Vt = f_ch[0] + f_ch[1] * (Tj - 25.0);\n"
"   ch_nphi = f_ch[2] * tn;\n"
"   ch_K = f_ch[3] * pow(tn, f_ch[4]);\n"
"   ch_Rd = f_ch[5] * pow(tn, f_ch[6]);\n"
"   ch_Iq = f_ch[7] * pow(tn, f_ch[8]);\n"
"   ch_theta = f_ch[9];\n"
"   ch_lambda = f_ch[10];\n"
"   ch_m = f_ch[11];\n"
"}\n"
"\n"
"/* intrinsic channel: smooth subthreshold, square law, soft saturation */\n"
"static double fch(double vgs, double vch)\n"
"{\n"
"   double vov = ch_nphi * softplus((vgs - ch_Vt) / ch_nphi);\n"
"   double keff, vde;\n"
"   if (vov < 1e-12 || vch <= 0.0) return 0.0;\n"
"   keff = ch_K / (1.0 + ch_theta * vov);\n"
"   vde = vch / pow(1.0 + pow(vch / vov, ch_m), 1.0 / ch_m);\n"
"   return keff * (vov * vde - 0.5 * vde * vde) * (1.0 + ch_lambda * vch);\n"
"}\n"
"\n"
"/* JFET/drift region drop with quasi-saturation */\n"
"static double vdrift(double I)\n"
"{\n"
"   double r = I / ch_Iq;\n"
"   return ch_Rd * I * (1.0 + r * r);\n"
"}\n"
"\n"
"static double gdrift(double I)\n"
"{\n"
"   double r = I / ch_Iq;\n"
"   return ch_Rd * (1.0 + 3.0 * r * r);\n"
"}\n"
"\n"
"/* forward conduction: solve I = fch(vgs, vds - vdrift(I)) (safeguarded Newto"
"n) */\n"
"static double fwd(double vgs, double vds)\n"
"{\n"
"   double lo = 0.0, hi, I, vch, f, g, dv, df, In;\n"
"   int k;\n"
"   if (vds <= 0.0) return 0.0;\n"
"   hi = vds / ch_Rd;\n"
"   I = fch(vgs, vds);\n"
"   if (I > hi) I = hi;\n"
"   for (k = 0; k < 60; k++)\n"
"   {\n"
"      vch = vds - vdrift(I);\n"
"      f = fch(vgs, vch);\n"
"      g = I - f;\n"
"      if (g > 0.0) hi = I; else lo = I;\n"
"      dv = 1e-6 * fmax(1.0, fabs(vch));\n"
"      df = (fch(vgs, vch + dv) - f) / dv;\n"
"      In = I - g / (1.0 + gdrift(I) * df);\n"
"      if (!(In > lo && In < hi)) In = 0.5 * (lo + hi);\n"
"      if (fabs(In - I) < 1e-10 * (1.0 + I))\n"
"      {\n"
"         I = In;\n"
"         break;\n"
"      }\n"
"      I = In;\n"
"   }\n"
"   return I;\n"
"}\n"
"\n"
"/* both quadrants: source/drain swap for vds < 0 (gate then referred to drain"
") */\n"
"static double ichan(double vgs, double vds)\n"
"{\n"
"   if (vds >= 0.0) return fwd(vgs, vds);\n"
"   return -fwd(vgs - vds, -vds);\n"
"}\n"
"\n"
"static double avalanche(double vds)\n"
"{\n"
"   if (vds <= 0.0) return 0.0;\n"
"   return softplus(vds - f_Vav) / f_Rav;\n"
"}\n"
"\n"
"/* log-linear interpolation of table y over axis x (n points) */\n"
"static double interp_log(const double *x, const double *y, int n, double v)\n"
"{\n"
"   int i = 1;\n"
"   double t;\n"
"   if (n < 2 || v <= x[0]) return y[0];\n"
"   if (v >= x[n - 1]) return y[n - 1];\n"
"   while (x[i] < v) i++;\n"
"   t = (v - x[i - 1]) / (x[i] - x[i - 1]);\n"
"   return exp(log(y[i - 1]) + t * (log(y[i]) - log(y[i - 1])));\n"
"}\n"
"\n"
"static double cap_gs(void)\n"
"{\n"
"   return fmax(f_Ciss - interp_log(f_V, f_Crss, f_nCap, f_Vciss), 1e-15);\n"
"}\n"
"\n"
"/* Cgd: datasheet Crss(Vdg) at Vgs = 0, scaled by kdyn with inverted channel,"
"\n"
" * rising to the gate-drain oxide capacitance when Vdg < 0 */\n"
"static double cap_gd(double vgs, double vds)\n"
"{\n"
"   double vdg = vds - vgs;\n"
"   double sg = 1.0 / (1.0 + exp(-(vgs - ch_Vt) / ch_nphi));\n"
"   double kd = 1.0 + (f_kdyn - 1.0) * sg;\n"
"   double c0 = kd * f_Crss[0];\n"
"   if (vdg >= 0.0) return kd * interp_log(f_V, f_Crss, f_nCap, vdg);\n"
"   return c0 + (f_Cgd_ox - c0) * (1.0 - exp(vdg / f_Vacc));\n"
"}\n"
"\n"
"static double cap_ds(double vds)\n"
"{\n"
"   double va = fmax(vds, 0.0);\n"
"   return fmax(interp_log(f_V, f_Coss, f_nCap, va) - interp_log(f_V, f_Crss, "
"f_nCap, va), 1e-15);\n"
"}"
              Show          off
            }
            Parameter {
              Variable      "StartFcn"
              Value         "int i;\n"
"if (ParamDim(0, 0) * ParamDim(0, 1) != 12)\n"
"{\n"
"   SetErrorMessage(\"Channel parameter vector must have 12 elements.\");\n"
"   return;\n"
"}\n"
"f_nCap = ParamDim(1, 0) * ParamDim(1, 1);\n"
"if (f_nCap > MAX_CAP)\n"
"{\n"
"   SetErrorMessage(\"Capacitance tables too long (max. 64 points).\");\n"
"   return;\n"
"}\n"
"if (ParamDim(2, 0) * ParamDim(2, 1) != f_nCap || ParamDim(3, 0) * ParamDim(3,"
" 1) != f_nCap)\n"
"{\n"
"   SetErrorMessage(\"Coss and Crss tables must have the same length as the vo"
"ltage axis.\");\n"
"   return;\n"
"}\n"
"for (i = 0; i < 12; i++) f_ch[i] = ParamRealData(0, i);\n"
"for (i = 0; i < f_nCap; i++)\n"
"{\n"
"   f_V[i] = ParamRealData(1, i);\n"
"   f_Coss[i] = ParamRealData(2, i);\n"
"   f_Crss[i] = ParamRealData(3, i);\n"
"}\n"
"f_Ciss = ParamRealData(4, 0);\n"
"f_Vciss = ParamRealData(4, 1);\n"
"f_Cgd_ox = ParamRealData(4, 2);\n"
"f_kdyn = ParamRealData(4, 3);\n"
"f_Vacc = ParamRealData(4, 4);\n"
"f_Vav = ParamRealData(5, 0);\n"
"f_Rav = ParamRealData(5, 1);\n"
"f_nPar = ParamRealData(6, 0);"
              Show          off
            }
            Parameter {
              Variable      "OutputFcn"
              Value         "double vg = InputSignal(1, 0);\n"
"double vd = InputSignal(2, 0);\n"
"double Tj = InputSignal(3, 0);\n"
"double n = f_nPar;\n"
"double ich;\n"
"if (!(Tj > -270.0 && Tj < 2000.0)) Tj = 25.0;\n"
"chan_update(Tj);\n"
"ich = n * (ichan(vg, vd) + avalanche(vd));\n"
"OutputSignal(0, 0) = ich;\n"
"OutputSignal(1, 0) = n * cap_gs();\n"
"OutputSignal(1, 1) = 0.0;\n"
"OutputSignal(2, 0) = n * cap_gd(vg, vd);\n"
"OutputSignal(2, 1) = 0.0;\n"
"OutputSignal(3, 0) = n * cap_ds(vd);\n"
"OutputSignal(3, 1) = 0.0;\n"
"OutputSignal(4, 0) = ich * vd;\n"
"if (IsMajorStep)\n"
"{\n"
"   if (InputSignal(0, 0) > 0.5)\n"
"   {\n"
"      OutputSignal(5, 0) = 1.0;\n"
"      OutputSignal(6, 0) = 0.0;\n"
"   }\n"
"   else\n"
"   {\n"
"      OutputSignal(5, 0) = 0.0;\n"
"      OutputSignal(6, 0) = 1.0;\n"
"   }\n"
"}\n"
"ZCSignal(0) = InputSignal(0, 0) - 0.5;"
              Show          off
            }
            Parameter {
              Variable      "UpdateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "DerivativeFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "TerminateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "StoreCustomStateFcn"
              Value         ""
              Show          off
            }
