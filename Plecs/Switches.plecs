              Value         "2"
              Show          off
            }
            Parameter {
              Variable      "HighlightLevel"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "Declarations"
              Value         "/* Power diode junction: datasheet forward curve "
"+ charge-control reverse recovery\n"
" * (Lauritzen/Ma): stored charge q, dq/dt = i - q/tau. The junction stays\n"
" * forward biased until q + TM*i = 0, then the reverse current -q/TM decays w"
"ith\n"
" * 1/TM + 1/tau (recovery tail). tau, TM are solved at start from the datashe"
"et\n"
" * recovery test (IF, di/dt, Irrm and trr or Qrr); tau scales with Tj^ktau.\n"
" * Inputs : 1 junction voltage Vj (anode - cathode) [V], 2 Tj [degC]\n"
" * Outputs: 1 junction current A->K [A], 2 [Cj 0] [F], 3 junction power [W],"
"\n"
" *          4 stored charge [C], 5 conduction state\n"
" * Parameters:\n"
" *   0 temperature axis [degC]  1 current axis [A] (first entry 0 -> knee)\n"
" *   2 forward voltage table, rows = temperatures, columns = currents [V]\n"
" *   3 Ron: on-state branch resistance below the knee (storage phase) [Ohm]\n"
" *   4 recovery test [IF didt Irrm trr Qrr Tmeas ktau] (Irrm = 0 -> no storag"
"e)\n"
" *   5 Cj reverse voltage axis [V]  6 Cj(V) [F]  7 nPara\n"
" *   8 reverse avalanche [Vbr Rav] (Vbr <= 0 -> disabled)\n"
" * The parameters are copied to the static data below in the start function: "
"the\n"
" * parameter access macros are only available inside the function sections.  "
"    */\n"
"#include <math.h>\n"
"\n"
"#define MAX_T     16\n"
"#define MAX_I     64\n"
"#define MAX_CJ    64\n"
"#define MODE      DiscState(0)\n"
"#define TAU_REF   DiscState(1)\n"
"#define T_M       DiscState(2)\n"
"\n"
"static int    d_nT, d_nI, d_nCj;\n"
"static double d_T[MAX_T], d_I[MAX_I], d_V[MAX_T * MAX_I];\n"
"static double d_Cv[MAX_CJ], d_Cc[MAX_CJ];\n"
"static double d_Ron, d_RR[7], d_nPar, d_Vbr, d_Rbr;\n"
"static double d_vk;\n"
"static double rr_tau, rr_TM;\n"
"\n"
"/* forward voltage at table column j, interpolated in temperature */\n"
"static double vtab(int j, double Tj)\n"
"{\n"
"   int nT = d_nT, k = 0;\n"
"   double t = 0.0;\n"
"   if (nT < 2) return d_V[j];\n"
"   if (Tj <= d_T[0])\n"
"   {\n"
"      k = 0;\n"
"      t = 0.0;\n"
"   }\n"
"   else if (Tj >= d_T[nT - 1])\n"
"   {\n"
"      k = nT - 2;\n"
"      t = 1.0;\n"
"   }\n"
"   else\n"
"   {\n"
"      while (d_T[k + 1] < Tj) k++;\n"
"      t = (Tj - d_T[k]) / (d_T[k + 1] - d_T[k]);\n"
"   }\n"
"   return d_V[k + nT * j] + t * (d_V[k + 1 + nT * j] - d_V[k + nT * j]);\n"
"}\n"
"\n"
"/* on-state junction current per device; below the knee (storage phase) the\n"
" * junction stays forward biased and the current follows (v - vk)/Ron */\n"
"static double i_on(double v, double Tj)\n"
"{\n"
"   int n = d_nI, j = 1;\n"
"   double v0, v1;\n"
"   d_vk = vtab(0, Tj);\n"
"   if (v < d_vk) return (v - d_vk) / d_Ron;\n"
"   while (j < n && vtab(j, Tj) < v) j++;\n"
"   if (j >= n)\n"
"   {\n"
"      v0 = vtab(n - 2, Tj);\n"
"      v1 = vtab(n - 1, Tj);\n"
"      return d_I[n - 1] + (d_I[n - 1] - d_I[n - 2]) * (v - v1) / (v1 - v0);\n"
"   }\n"
"   v0 = vtab(j - 1, Tj);\n"
"   v1 = vtab(j, Tj);\n"
"   return d_I[j - 1] + (d_I[j] - d_I[j - 1]) * (v - v0) / (v1 - v0);\n"
"}\n"
"\n"
"static double cap_j(double v)\n"
"{\n"
"   int n = d_nCj, i = 1;\n"
"   double x = fmax(-v, 0.0), t;\n"
"   if (n < 2 || x <= d_Cv[0]) return d_Cc[0];\n"
"   if (x >= d_Cv[n - 1]) return d_Cc[n - 1];\n"
"   while (d_Cv[i] < x) i++;\n"
"   t = (x - d_Cv[i - 1]) / (d_Cv[i] - d_Cv[i - 1]);\n"
"   return exp(log(d_Cc[i - 1]) + t * (log(d_Cc[i]) - log(d_Cc[i - 1])));\n"
"}\n"
"\n"
"/* stored charge at t1 after a linear ramp from IF (steady state) with slope "
"-a */\n"
"static double rr_res(double tau, double trec, double IF, double a, double Irr"
"m, double t1)\n"
"{\n"
"   double TM = 1.0 / (1.0 / trec - 1.0 / tau);\n"
"   double q = tau * IF + a * tau * tau - a * tau * t1 - a * tau * tau * exp(-"
"t1 / tau);\n"
"   return q - TM * Irrm;\n"
"}\n"
"\n"
"/* solve tau, TM from the recovery test; returns 0 if no storage */\n"
"static int rr_solve(void)\n"
"{\n"
"   double IF = d_RR[0], a = d_RR[1], Irrm = d_RR[2], trr = d_RR[3], Qrr = d_R"
"R[4];\n"
"   double ts, trec, t1, lo, hi, mid;\n"
"   int k;\n"
"   rr_tau = 0.0;\n"
"   rr_TM = 1e-9;\n"
"   if (!(Irrm > 0.0) || !(a > 0.0) || !(IF > 0.0)) return 0;\n"
"   ts = Irrm / a;\n"
"   if (trr > 0.0) trec = (trr - ts) / log(10.0);\n"
"   else trec = (Qrr - 0.5 * Irrm * ts) / Irrm;\n"
"   if (!(trec > 0.0)) return -1;\n"
"   t1 = IF / a + ts;\n"
"   lo = log(trec * 1.000001);\n"
"   hi = log(1e-2);\n"
"   if (rr_res(exp(lo), trec, IF, a, Irrm, t1) * rr_res(exp(hi), trec, IF, a, "
"Irrm, t1) > 0.0) return -1;\n"
"   for (k = 0; k < 200; k++)\n"
"   {\n"
"      mid = 0.5 * (lo + hi);\n"
"      if (rr_res(exp(mid), trec, IF, a, Irrm, t1) < 0.0) lo = mid; else hi = "
"mid;\n"
"   }\n"
"   rr_tau = exp(0.5 * (lo + hi));\n"
"   rr_TM = 1.0 / (1.0 / trec - 1.0 / rr_tau);\n"
"   return 1;\n"
"}\n"
"\n"
"/* reverse avalanche current (A->K, negative) */\n"
"static double i_av(double v)\n"
"{\n"
"   if (!(d_Vbr > 0.0)) return 0.0;\n"
"   if (-v - d_Vbr > 30.0) return (v + d_Vbr) / d_Rbr;\n"
"   return -log1p(exp(-v - d_Vbr)) / d_Rbr;\n"
"}\n"
"\n"
"/* carrier lifetime at Tj (tau_ref at the recovery test temperature) */\n"
"static double tau_at(double tau_ref, double Tj)\n"
"{\n"
"   return tau_ref * pow((Tj + 273.15) / (d_RR[5] + 273.15), d_RR[6]);\n"
"}\n"
"\n"
"static double temp_in(double Tj)\n"
"{\n"
"   if (!(Tj > -270.0 && Tj < 2000.0)) return 25.0;\n"
"   return Tj;\n"
"}"
              Show          off
            }
            Parameter {
              Variable      "StartFcn"
              Value         "int i;\n"
"d_nT = ParamDim(0, 0) * ParamDim(0, 1);\n"
"d_nI = ParamDim(1, 0) * ParamDim(1, 1);\n"
"d_nCj = ParamDim(5, 0) * ParamDim(5, 1);\n"
"if (d_nT > MAX_T || d_nI > MAX_I || d_nCj > MAX_CJ)\n"
"{\n"
"   SetErrorMessage(\"Diode tables too long (max. 16 temperatures, 64 currents"
", 64 Cj points).\");\n"
"   return;\n"
"}\n"
"if (ParamDim(2, 0) != d_nT || ParamDim(2, 1) != d_nI)\n"
"{\n"
"   SetErrorMessage(\"Forward voltage table must have one row per temperature "
"and one column per current.\");\n"
"   return;\n"
"}\n"
"if (d_nI < 2 || ParamDim(4, 0) * ParamDim(4, 1) != 7 || ParamDim(6, 0) * Para"
"mDim(6, 1) != d_nCj\n"
"    || ParamDim(8, 0) * ParamDim(8, 1) != 2)\n"
"{\n"
"   SetErrorMessage(\"Invalid diode parameters (current axis, recovery [IF did"
"t Irrm trr Qrr Tmeas ktau], Cj table or [Vbr Rav]).\");\n"
"   return;\n"
"}\n"
"for (i = 0; i < d_nT; i++) d_T[i] = ParamRealData(0, i);\n"
"for (i = 0; i < d_nI; i++) d_I[i] = ParamRealData(1, i);\n"
"for (i = 0; i < d_nT * d_nI; i++) d_V[i] = ParamRealData(2, i);\n"
"for (i = 0; i < 7; i++) d_RR[i] = ParamRealData(4, i);\n"
"for (i = 0; i < d_nCj; i++)\n"
"{\n"
"   d_Cv[i] = ParamRealData(5, i);\n"
"   d_Cc[i] = ParamRealData(6, i);\n"
"}\n"
"d_Ron = ParamRealData(3, 0);\n"
"d_nPar = ParamRealData(7, 0);\n"
"d_Vbr = ParamRealData(8, 0);\n"
"d_Rbr = ParamRealData(8, 1);\n"
"if (rr_solve() < 0)\n"
"{\n"
"   SetErrorMessage(\"Reverse recovery data inconsistent: need trr > Irrm/(di/"
"dt) (or Qrr > Irrm^2/(2 di/dt)).\");\n"
"   return;\n"
"}\n"
"MODE = 0.0;\n"
"TAU_REF = rr_tau;\n"
"T_M = rr_TM;\n"
"ContState(0) = 0.0;"
              Show          off
            }
            Parameter {
              Variable      "OutputFcn"
              Value         "double v = InputSignal(0, 0);\n"
"double Tj = temp_in(InputSignal(1, 0));\n"
"double n = d_nPar;\n"
"double q = ContState(0);\n"
"double ion = i_on(v, Tj);\n"
"double ij;\n"
"if (MODE > 0.5) ij = ion;\n"
"else if (TAU_REF > 0.0) ij = -q / T_M;\n"
"else ij = 0.0;\n"
"ij += i_av(v);\n"
"OutputSignal(0, 0) = -n * ij;                  /* Ij is drawn cathode -> anod"
"e: source current = -(A->K current) */\n"
"OutputSignal(1, 0) = n * cap_j(v);\n"
"OutputSignal(1, 1) = 0.0;\n"
"OutputSignal(2, 0) = n * ij * v;\n"
"OutputSignal(3, 0) = n * q;\n"
"OutputSignal(4, 0) = MODE;\n"
"ZCSignal(0) = v - d_vk;\n"
"ZCSignal(1) = q + T_M * ion;"
              Show          off
            }
            Parameter {
              Variable      "UpdateFcn"
              Value         "double v = InputSignal(0, 0);\n"
"double Tj = temp_in(InputSignal(1, 0));\n"
"double q = ContState(0);\n"
"double ion = i_on(v, Tj);\n"
"if (MODE < 0.5)\n"
"{\n"
"   if (v >= d_vk) MODE = 1.0;\n"
"}\n"
"else if (ion < 0.0 && q + T_M * ion < 0.0)\n"
"{\n"
"   MODE = 0.0;\n"
"}"
              Show          off
            }
            Parameter {
              Variable      "DerivativeFcn"
              Value         "double v = InputSignal(0, 0);\n"
"double Tj = temp_in(InputSignal(1, 0));\n"
"double q = ContState(0);\n"
"double tau;\n"
"if (TAU_REF <= 0.0)\n"
"{\n"
"   ContDeriv(0) = 0.0;\n"
"   return;\n"
"}\n"
"tau = tau_at(TAU_REF, Tj);\n"
"if (MODE > 0.5) ContDeriv(0) = i_on(v, Tj) - q / tau;\n"
"else ContDeriv(0) = -q / T_M - q / tau;"
              Show          off
            }
            Parameter {
              Variable      "TerminateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "StoreCustomStateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "RestoreCustomStateFcn"
              Value         ""
              Show          off
            }
          }
