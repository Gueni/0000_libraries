    Component {
      Type          ConfigurableSubsystem
      Name          "D"
      Show          on
      Position      [120, 145]
      Direction     up
      Flipped       off
      LabelPosition west
      Frame         [-15, -10; 15, 10]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Diode"
      MaskDescription "Power diode with selectable model depth (Diode.Config):"
"\n"
"1 - Diode Thermal: ideal diode with thermal description (therm_diode, vf_diod"
"e, ron_diode, Case_*).\n"
"2 - Physical Discrete: datasheet forward curve vs. temperature (VI, Ron), cha"
"rge-control reverse recovery (RR), junction capacitance (Cj), forward recover"
"y (FR), avalanche (Aval), leakage (Roff), package (Pkg), losses into a Cauer "
"chain (Th). As a body diode set Pkg.La = Pkg.Lk = 0.\n"
"Port 1 = cathode, port 2 = anode."
      MaskDisplay   "line([0, 0], [6, 14])\n"
"line([-7, 7], [-6, -6])\n"
"line([0,0], [-14, -6])\n"
"line([0, 7, -7, 0], [-6, 6, 6, -6])\n"
      MaskIconFrame off
      MaskIconOpaque on
      MaskIconRotates on
      MaskInit      "% scaling diode curves\n"
"%if(~isempty(Diode.therm_diode.Von))\n"
"%\tDiode.therm_diode.Von.i = Diode.therm_diode.Von.i*Diode.num_par_diode;\n"
"%end\n"
"%if(~isempty(Diode.therm_diode.Eon))\n"
"%\tDiode.therm_diode.Eon.i = Diode.therm_diode.Eon.i*Diode.num_par_diode;\n"
"%\tDiode.therm_diode.Eon.E = Diode.therm_diode.Eon.E*Diode.num_par_diode;\n"
"%end\n"
"%if(~isempty(Diode.therm_diode.Eoff))\n"
"%\tDiode.therm_diode.Eoff.i = Diode.therm_diode.Eoff.i*Diode.num_par_diode;\n"
"%\tDiode.therm_diode.Eoff.E = Diode.therm_diode.Eoff.E*Diode.num_par_diode;\n"
"%end\n"
"%if(~isempty(Diode.therm_diode.CauerChain)) \n"
"%\tDiode.therm_diode.CauerChain.R = Diode.therm_diode.CauerChain.R/(Diode.num"
"_par_diode);\n"
"%\tDiode.therm_diode.CauerChain.C = Diode.therm_diode.CauerChain.C*Diode.num_"
"par_diode;\n"
"%end"
