              Value         "Diode.VI.T, Diode.VI.I, Diode.VI.V, Diode.Ron, [D"
"iode.RR.IF Diode.RR.didt Diode.RR.Irrm Diode.RR.trr Diode.RR.Qrr Diode.RR.Tme"
"as Diode.RR.ktau], Diode.Cj.V, Diode.Cj.C, Diode.nPara, [Diode.Aval.Vbr Diode"
".Aval.Rav]"
              Show          off
            }
            Parameter {
              Variable      "LangStandard"
              Value         "2"
              Show          off
            }
            Parameter {
              Variable      "GnuExtensions"
              Value         "1"
