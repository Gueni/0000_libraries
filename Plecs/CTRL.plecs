          Annotation {
            Name          "<html><body><p><span style=\" font-size:14px; font-"
"weight:600; color:#55007f;\">MEASUREMENTS</span></p><p><span style=\" font-si"
"ze:10px; color:#555555;\">Probes of Vdc, vac and iL; |vac| and clamped Vdc sh"
"ared through Goto tags</span></p></body></html>"
            Position      [250, 105]
          } 
          Annotation {
            Name          "<html><body><p><span style=\" font-size:14px; font-"
"weight:600; color:#55007f;\">VOLTAGE LOOP</span></p><p><span style=\" font-si"
"ze:10px; color:#555555;\">Soft-start ramp of Vref, error low-pass filter, PI "
"-> power command P*</span></p></body></html>"
            Position      [600, 105]
          } 
          Annotation {
            Name          "<html><body><p><span style=\" font-size:14px; font-"
"weight:600; color:#55007f;\">CURRENT REFERENCE</span></p><p><span style=\" fo"
"nt-size:10px; color:#555555;\">Iref = |vac| * P* / Vrms^2, limited to Ipk_max"
"</span></p></body></html>"
            Position      [1315, 105]
          } 
          Annotation {
            Name          "<html><body><p><span style=\" font-size:14px; font-"
"weight:600; color:#55007f;\">INDUCTOR CURRENT RECTIFICATION</span></p><p><spa"
"n style=\" font-size:10px; color:#555555;\">|iL| = iL * sign(vac), sign = vac"
" / (|vac| + eps)</span></p></body></html>"
            Position      [210, 380]
          } 
          Annotation {
            Name          "<html><body><p><span style=\" font-size:14px; font-"
"weight:600; color:#55007f;\">CURRENT LOOP</span></p><p><span style=\" font-si"
"ze:10px; color:#555555;\">PI on Iref - |iL| -> inductor voltage command uL*</"
"span></p></body></html>"
            Position      [560, 380]
          } 
