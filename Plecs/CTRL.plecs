"Dialog:set('Tf', 'Visible', choice ~= '2')\n"
"Dialog:set('Rounding', 'Visible', choice ~= '1')\n"
"if choice == '1' then\n"
"  Block:showTerminal('T', false)\n"
"  Block:moveTerminal('u', -15, 0)\n"
