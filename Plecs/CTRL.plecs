"\n"
"if Dialog:get('DelayTimeSource') ~= '1' then\n"
" Icon:text(-11, 5, 'T', 'FontSize', 8)\n"
"end\n"
"\n"
"Icon:color(0, 178, 0)\n"
"Icon:line({-11, -7, -7, 7, 7, 11}, {7, 7, -7, -7 ,7, 7})\n"
"Icon:line({-7, -1, -1}, {7, 7, -7})\n"
